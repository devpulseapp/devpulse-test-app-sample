{
  "apiVersion": 2,
  "manifestVersion": 2,
  "id": "placeholder.sample-app",
  "version": "0.4.0",
  "displayName": "Placeholder Sample App",
  "description": "A placeholder App for testing DevPulse Apps: a sidebar panel, a workspace tab, a command and a background task.",
  "category": "tool",
  "publisher": {
    "id": "placeholder",
    "displayName": "Marketplace test placeholder"
  },
  "authors": [
    {
      "name": "Marketplace test placeholder"
    }
  ],
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "readme": "README.md",
  "defaultLocale": "en",
  "locales": [],
  "engines": {
    "devpulse": ">=0.0.1 <1.0.0"
  },
  "target": {
    "platform": "any",
    "architecture": "any"
  },
  "apiFeatures": {
    "required": [
      "contributions.integration-v1",
      "runtime.trusted-node-v1",
      "apps.permissions-v1"
    ],
    "optional": []
  },
  "runtime": {
    "id": "sample-app",
    "tier": "trusted-node",
    "artifact": "node-esm",
    "entrypoint": "app/main.js"
  },
  "contributes": [
    {
      "id": "sample",
      "type": "integration",
      "displayName": "Placeholder Sample App",
      "description": "Counts pings and keeps a log, to test Apps.",
      "permissionIds": [
        "panel",
        "tab",
        "menu",
        "background"
      ],
      "settingIds": [],
      "requirementIds": [],
      "sidebar": {
        "title": "Sample",
        "icon": "bolt",
        "page": "views/panel.html"
      },
      "tab": {
        "title": "Sample log",
        "icon": "list",
        "page": "views/tab.html"
      },
      "commands": [
        {
          "id": "ping",
          "title": "Ping"
        }
      ],
      "tasks": [
        {
          "id": "write-log",
          "title": "Write a log line",
          "everyMinutes": 15
        }
      ]
    }
  ],
  "permissions": [
    {
      "id": "panel",
      "capability": "workspace.panel.open",
      "scope": {
        "kind": "add-on"
      },
      "requiredness": "required",
      "reason": "Shows the ping count in a sidebar panel."
    },
    {
      "id": "tab",
      "capability": "workspace.tab.open",
      "scope": {
        "kind": "add-on"
      },
      "requiredness": "required",
      "reason": "Shows the log in a workspace tab."
    },
    {
      "id": "menu",
      "capability": "menu.commands.add",
      "scope": {
        "kind": "add-on"
      },
      "requiredness": "required",
      "reason": "Adds Ping to the Apps menu."
    },
    {
      "id": "background",
      "capability": "background.tasks.run",
      "scope": {
        "kind": "add-on"
      },
      "requiredness": "required",
      "reason": "Writes a log line every 15 minutes."
    }
  ],
  "requirements": [],
  "settings": []
}
